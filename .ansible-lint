---
# profile: min is ansible-lint's lowest profile. It only requires that
# Ansible can load the content (internal-error, load-failure,
# parser-error, syntax-check). jinja, yaml, key-order, fqcn, and the
# rest are not in this profile. `production` is the profile Ansible
# Automation Platform uses for validated content; this repository does
# not enable it. warn_list entries below belong to the `basic` profile
# and do not run while profile stays `min`.
#
# --offline is required when running ansible-lint by hand: without it,
# dependency resolution hangs on a network call. CI config needs the
# same flag or a vendored/cached collection set.
profile: min

warn_list:
  # Many instances are terse test fixtures. A deliberate naming-
  # convention cleanup pass, not a blocker.
  - name[missing]
  # A mechanical rename with real risk of missing a dynamic or
  # string-interpolated reference. Needs per-instance verification,
  # not a blind find-and-replace.
  - var-naming[no-role-prefix]

# Do not list aknochow.* modules here. ansible-lint writes those stubs
# through ~/.ansible/collections/.../aknochow/* which on this machine
# (and any laptop using INV-11 symlinks) are the source repos. One
# `ansible-lint --offline` replaced six real modules with
# argument_spec=dict() (2026-09-05 outage; again 2026-09-09). CI
# installs the collections from collections-requirements.yml instead.


exclude_paths:
  - .venv/
  - public/
  # Local worktree checkouts (gitignored, never committed) that
  # ansible-lint would otherwise walk and lint anyway.
  - .claude/worktrees/
  # CI / local `ansible-galaxy -p` dest inside the checkout. Lint the
  # playbook, not the installed collection trees.
  - .galaxy-collections/
  # Event-Driven Ansible rulebooks are not playbooks.
  - eda/
